// 1. FIX: private conversation metadata leak — replace `allow list: if isSignedIn();`
//    inside match /conversations/{conversationId} with:
    allow list: if isSystemAdmin();

// 2. FIX: admins can't read their own doc + no owner bootstrap.
//    Replace the whole match /admins/{adminId} block with:
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /admins/{adminId} {
      allow get: if isSignedIn() && adminId == request.auth.uid;
      allow list: if isSystemMaintainer();
      allow create: if (isSystemOwner() && adminId != request.auth.uid) ||
        (isSignedIn() && adminId == request.auth.uid && request.resource.data.role == 'owner' &&
         exists(/databases/$(database)/documents/config/bootstrap) &&
         get(/databases/$(database)/documents/config/bootstrap).data.allowOwnerBootstrap == true);
      allow update, delete: if isSystemOwner() && adminId != request.auth.uid;
    }

// 3. ADD: per-user conversation index (the app reads this instead of listing
//    /conversations). Add INSIDE match /users/{userId}, after its allow rules:
      match /conversations/{convId} {
        allow read: if isOwnerUser(userId);
        allow create: if isSignedIn() && (isOwnerUser(userId) || isConversationParticipant(convId));
        allow delete: if isOwnerUser(userId) || isSystemMaintainer();
      }

// 4. ADD: let any group member leave (removing only themselves).
//    Add as an extra OR-branch in match /conversations/{conversationId} update:
        (isConversationParticipant(conversationId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
          !(request.auth.uid in request.resource.data.participants))
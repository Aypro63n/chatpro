rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role Hierarchy Definitions
    // Level 4: Owner (system superuser)
    function isSystemOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'anuragyadav3835@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // Level 3: Admin
    function isSystemAdmin() {
      return isSystemOwner() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner']) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Level 2: Maintainer
    function isSystemMaintainer() {
      return isSystemAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['maintainer', 'admin', 'owner']
      );
    }

    // Admins collection (legacy & bootstrap)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSystemOwner();
    }

    // Users collection with strict hierarchy enforcement
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // User bootstrap
      allow create: if isOwnerUser(userId) && (
        request.resource.data.role == 'member' || isSystemOwner()
      );
      
      // Hierarchical updates:
      // 1. Owner can manage all accounts and all roles
      // 2. Admin can manage only Maintainer & Member (cannot touch other Admins or Owner, cannot grant Admin)
      // 3. Maintainer can only apply mutes to Members (no role modification)
      // 4. Regular users can only update non-permission profile fields (cannot change role, suspension, mute)
      allow update: if isSignedIn() && (
        isSystemOwner() ||
        (
          isSystemAdmin() &&
          resource.data.role in ['member', 'maintainer'] &&
          (!('role' in request.resource.data) || request.resource.data.role in ['member', 'maintainer'])
        ) ||
        (
          isSystemMaintainer() &&
          resource.data.role == 'member' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isMuted', 'muteUntil'])
        ) ||
        (
          isOwnerUser(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == resource.data.isSuspended) &&
          (!('isMuted' in request.resource.data) || request.resource.data.isMuted == resource.data.isMuted)
        )
      );

      // Account deletion downward only
      allow delete: if isSystemOwner() || (isSystemAdmin() && resource.data.role in ['member', 'maintainer']);
    }

    // Audit logs for role and moderation actions
    match /auditLogs/{logId} {
      allow read: if isSystemMaintainer() || isSystemAdmin() || isSystemOwner();
      allow create: if isSignedIn() && (isSystemMaintainer() || isSystemAdmin() || isSystemOwner()) &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Global Chat (shared public room for all authenticated users)
    match /globalMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        isSystemMaintainer()
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        isSystemMaintainer()
      );
    }

    // Global typing indicators
    match /globalTyping/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwnerUser(userId);
    }

    // Helper to verify participant of a conversation
    function isConversationParticipant(convId) {
      let convPath = /databases/$(database)/documents/conversations/$(convId);
      return exists(convPath) && 
        'participants' in get(convPath).data && 
        (request.auth.uid in get(convPath).data.participants);
    }

    // Conversations collection (for 1-on-1 and groups)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (
        resource == null ||
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        isSystemAdmin()
      );
      allow list: if isSignedIn() && (
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        isSystemAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.participants != null &&
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isSignedIn() && (
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        isSystemAdmin()
      );
      allow delete: if isSignedIn() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
        isSystemAdmin()
      );

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isConversationParticipant(conversationId) ||
          isSystemAdmin()
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (isConversationParticipant(conversationId) || isSystemAdmin());
        allow update: if isSignedIn() && (
          isConversationParticipant(conversationId) ||
          isSystemAdmin()
        );
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          isSystemAdmin()
        );
      }

      // Typing indicators subcollection
      match /typing/{userId} {
        allow read: if isSignedIn() && (
          isConversationParticipant(conversationId) ||
          isSystemAdmin()
        );
        allow write: if isOwnerUser(userId);
      }
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isSystemMaintainer();
    }
  }
}
